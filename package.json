{
  "name": "iso-fns",
  "description": "A string-based date-time library for Javascript.",
  "version": "2.0.0-alpha.26",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "types": "./index.d.cts",
  "license": "MIT",
  "homepage": "iso-fns.org",
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "CHANGELOG"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubber-duck-software/iso-fns.git"
  },
  "scripts": {
    "lint": "oxfmt --check ./src",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "build": "tsdown src/index.ts --format esm,cjs --dts --out-dir dist",
    "build-package": "./scripts/release.sh",
    "test": "pnpm lint && c8 -r text node --disable-warning=ExperimentalWarning ./run-tests.js",
    "cc": "c8 report -r lcovonly",
    "coveralls": "cat ./coverage/lcov.info | node node_modules/.bin/coveralls",
    "docs": "node ./scripts/generate-docs.js",
    "verify-build": "pnpm format && pnpm build && pnpm test && pnpm cc && pnpm docs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "all-contributors-cli": "^6.20.0",
    "beartest-js": "^6.0.2",
    "c8": "^7.7.3",
    "coveralls": "^3.1.1",
    "expect": "^27.0.6",
    "oxfmt": "^0.55.0",
    "shelljs": "^0.8.4",
    "tsdown": "^0.22.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "temporal-polyfill": "^0.3.2"
  }
}
